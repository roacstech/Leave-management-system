generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}


//-----------User model------------
enum Role {
  CEO
  ADMIN
  TL
  EMPLOYEE
}

model User {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  password      String
  role          Role
  teamId        Int?
  reportingToId Int?
  isActive      Boolean        @default(true)
  team          Team?          @relation(fields: [teamId], references: [id])
  reportingTo   User?          @relation("UserReportingHierarchy", fields: [reportingToId], references: [id])
  reportees     User[]         @relation("UserReportingHierarchy")
  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]
  attendance    Attendance[]
  notifications Notification[]
  auditLogs     AuditLog[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

//--------Team model-------------

model Team {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
}

//--------Leave type model---------

model LeaveType {
  id                  Int            @id @default(autoincrement())
  name                String         @unique
  code                String         @unique
  description         String?
  category            String         @default("Annual")
  annualAllocation    Float          @default(0)
  isPaid              Boolean        @default(true)
  carryForward        Boolean        @default(false)
  maxCarryForwardDays Int            @default(0)
  maxConsecutiveDays  Int            @default(14)
  requiresApproval    Boolean        @default(true)
  requiresAttachment  Boolean        @default(false)
  minimumNoticeDays   Int            @default(0)
  isActive            Boolean        @default(true)
  leaveBalances       LeaveBalance[]
  leaveRequests       LeaveRequest[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

//--------Role Definition model---------

model RoleDefinition {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  code        String   @unique
  description String?
  permissions String?  @default("VIEW_DASHBOARD,APPLY_LEAVE")
  accessLevel String   @default("STANDARD")
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


//--------LeaveBalance model------

model LeaveBalance {
  id          Int      @id @default(autoincrement())
  userId      Int
  leaveTypeId Int
  year        Int
  total       Float
  used        Float    @default(0)
  remaining   Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([userId, leaveTypeId, year])
  @@index([leaveTypeId])
  @@index([userId])
}

//-----Leave status and request

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  ESCALATED
}

model LeaveRequest {
  id            Int         @id @default(autoincrement())
  userId        Int
  leaveTypeId   Int
  startDate     DateTime
  endDate       DateTime
  reason        String?
  status        LeaveStatus @default(PENDING)
  rejectionReason String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user          User       @relation(fields: [userId], references: [id])
  leaveType     LeaveType  @relation(fields: [leaveTypeId], references: [id])

  @@index([userId])
  @@index([leaveTypeId])
}

model Attendance {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      DateTime
  checkIn   DateTime?
  checkOut  DateTime?
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@index([userId])
}

model Holiday {
  id          Int      @id @default(autoincrement())
  name        String
  fromDate    DateTime
  toDate      DateTime
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  entity    String
  entityId  Int?
  details   String?  @db.Text
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId])
}

//--------System Settings model-------------

model SystemSettings {
  id                         Int      @id @default(autoincrement())
  
  // Organization Settings
  companyName                String   @default("Roacs Corporation")
  companyEmail               String   @default("admin@company.com")
  timezone                   String   @default("Asia/Kolkata")
  dateFormat                 String   @default("DD/MM/YYYY")

  // Attendance Settings
  officeStartTime            String   @default("09:00 AM")
  officeEndTime              String   @default("06:00 PM")
  gracePeriodMinutes         Int      @default(10)
  halfDayHours               Float    @default(4.0)
  workingDays                String   @default("Monday,Tuesday,Wednesday,Thursday,Friday")

  // Leave Settings
  leaveYear                  String   @default("January - December")
  allowHalfDayLeave          Boolean  @default(true)
  allowBackdatedLeave        Boolean  @default(false)
  allowNegativeLeaveBalance  Boolean  @default(false)
  carryForwardLeave          Boolean  @default(true)

  // Notification Settings
  emailNotificationsEnabled  Boolean  @default(true)
  inAppNotificationsEnabled  Boolean  @default(true)
  notifyLeaveApproved        Boolean  @default(true)
  notifyLeaveRejected        Boolean  @default(true)
  notifyNewLeaveRequest      Boolean  @default(true)
  notifyLeaveCancellation    Boolean  @default(true)

  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}